# Copy to .env and fill in. Never commit .env.

# Required. At least 32 characters - generate with: openssl rand -base64 48
JWT_SECRET=

# Google Gemini key from https://aistudio.google.com/apikey
# Leave empty to run in offline demo mode (rule-based reviews, no AI).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Comma-separated backups used when the main model is overloaded
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash

# auto | gemini | demo
AI_PROVIDER=auto

# Optional: use an external Postgres (e.g. Neon) instead of the docker compose one
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Database password used by docker compose
DB_PASSWORD=reviewassist

# Optional server tuning
# JWT_TTL=12h
# REVIEW_MAX_CODE_CHARS=20000
# REVIEW_PER_MINUTE_LIMIT=10
